# ============================================================
# MediScan — Required Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# --- AI / Gemini ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# --- Flask Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY="generate-a-strong-random-key"

# --- Anti-Counterfeit HMAC ---
# Used to sign QR codes. Changing this invalidates all previously generated QR codes.
SIGNING_SECRET="generate-another-strong-random-key"

# --- Google OAuth ---
# Get from: console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# --- Company Features ---
# Secret code that grants "company" role when entered during registration/login
COMPANY_INVITE_CODE="your-invite-code"

# --- Database ---
# For local development (SQLite): Leave blank or remove this line
# For production (PostgreSQL/Neon): Set the full connection string
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Environment ---
# Set to "production" for deployed environments (enables secure cookies, disables demo login)
# FLASK_ENV=production
